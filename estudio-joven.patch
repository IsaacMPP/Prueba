+#[test]
+fn estudio_joven_separates_answer_from_new_spanish_question() {
+    // Two voices may incorrectly share the same diarization label: punctuation is an extra cue.
+    let tokens = ["iglesia", "y", "para", "Dios.", "¿Cuál", "ha", "sido", "el", "momento?"];
+    let words: Vec<SeqWord> = tokens.iter().enumerate().map(|(i, txt)| SeqWord {
+        text: (*txt).into(), start: s(i as f64 * 0.3), end: s((i+1) as f64 * 0.3),
+        clip: ClipId(1), item: MEDIA, index: i, track: 0,
+        speaker: Some("Speaker 1".into()), confidence: 1.0,
+    }).collect();
+    let opts = CaptionRules {
+        max_chars: 42, lines: 2,
+        strict_sentences: true, spanish_questions: true,
+        ..Default::default()
+    };
+    let output = caption_blocks(&words, &opts, R);
+    assert_eq!(output.len(), 2, "interviewer question must not join the previous answer");
+    assert_eq!(output[0].text, "iglesia y para Dios.");
+    assert_eq!(output[1].text, "¿Cuál ha sido el momento?");
+    assert_eq!(output[0].words, 0..4);
+    assert_eq!(output[1].words, 4..9);
+}
+
+#[test]
+fn estudio_joven_breaks_at_inverted_question_without_previous_period() {
+    let tokens = ["por", "Dios", "¿Cuál", "fue", "tu", "experiencia?"];
+    let words: Vec<SeqWord> = tokens.iter().enumerate().map(|(i, txt)| SeqWord {
+        text: (*txt).into(), start: s(i as f64 * 0.24), end: s((i+1) as f64 * 0.24),
+        clip: ClipId(1), item: MEDIA, index: i, track: 0, speaker: None, confidence: 1.0,
+    }).collect();
+    let opts = CaptionRules { strict_sentences: true, spanish_questions: true, ..Default::default() };
+    let output = caption_blocks(&words, &opts, R);
+    assert_eq!(output.len(), 2);
+    assert_eq!(output[0].text, "por Dios");
+    assert_eq!(output[1].text, "¿Cuál fue tu experiencia?");
+}
