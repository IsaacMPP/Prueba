+// Studio Joven: this is a NATIVE FilmCraft panel, not a separate BAT or Electron app.
+// Options live in egui's per-session memory and apply to the caption track generated below.
+fn estudio_joven_params(ctx: &egui::Context) -> Value {
+    let g = |name: &str| egui::Id::new(("estudio-joven-captions", name));
+    let chars = ctx.data(|d| d.get_temp::<u32>(g("chars"))).unwrap_or(32);
+    let lines = ctx.data(|d| d.get_temp::<u32>(g("lines"))).unwrap_or(2);
+    let min_seconds = ctx.data(|d| d.get_temp::<f64>(g("min"))).unwrap_or(0.6);
+    let max_seconds = ctx.data(|d| d.get_temp::<f64>(g("max"))).unwrap_or(3.0);
+    let pause = ctx.data(|d| d.get_temp::<f64>(g("pause"))).unwrap_or(0.4);
+    let sentences = ctx.data(|d| d.get_temp::<bool>(g("sentences"))).unwrap_or(true);
+    let questions = ctx.data(|d| d.get_temp::<bool>(g("questions"))).unwrap_or(true);
+    json!({
+        "maxChars": chars, "lines": lines, "minSeconds": min_seconds,
+        "maxSeconds": max_seconds.max(min_seconds), "pauseSeconds": pause,
+        "strictSentences": sentences, "spanishQuestions": questions,
+        "name": "Estudio Joven - Subtitulos"
+    })
+}
+
+fn estudio_joven_panel(ui: &mut egui::Ui, app: &mut FilmcraftApp, rect: Rect, actions: &mut Vec<(String, Value)>) {
+    let t = app.tokens;
+    ui.painter().rect_filled(rect, 5.0, t.field_bg);
+    let g = |name: &str| egui::Id::new(("estudio-joven-captions", name));
+    let mut chars = ui.ctx().data(|d| d.get_temp::<u32>(g("chars"))).unwrap_or(32);
+    let mut lines = ui.ctx().data(|d| d.get_temp::<u32>(g("lines"))).unwrap_or(2);
+    let mut min_s = ui.ctx().data(|d| d.get_temp::<f64>(g("min"))).unwrap_or(0.6);
+    let mut max_s = ui.ctx().data(|d| d.get_temp::<f64>(g("max"))).unwrap_or(3.0);
+    let mut pause = ui.ctx().data(|d| d.get_temp::<f64>(g("pause"))).unwrap_or(0.4);
+    let mut sentences = ui.ctx().data(|d| d.get_temp::<bool>(g("sentences"))).unwrap_or(true);
+    let mut questions = ui.ctx().data(|d| d.get_temp::<bool>(g("questions"))).unwrap_or(true);
+    let mut child = ui.new_child(egui::UiBuilder::new().max_rect(rect.shrink(7.0)).id_salt("estudio-joven-native-settings"));
+    child.label(egui::RichText::new("ESTUDIO JOVEN  |  Crear subtitulos").strong().size(12.0).color(t.text));
+    child.horizontal_wrapped(|ui| {
+        ui.label("Caracteres/linea");
+        ui.add(egui::DragValue::new(&mut chars).range(12..=70));
+        ui.label("Lineas");
+        ui.add(egui::DragValue::new(&mut lines).range(1..=3));
+    });
+    child.horizontal_wrapped(|ui| {
+        ui.label("Min s");
+        ui.add(egui::DragValue::new(&mut min_s).range(0.2..=6.0).speed(0.05));
+        ui.label("Max s");
+        ui.add(egui::DragValue::new(&mut max_s).range(0.5..=9.0).speed(0.1));
+        ui.label("Pausa s");
+        ui.add(egui::DragValue::new(&mut pause).range(0.0..=2.0).speed(0.05));
+    });
+    child.horizontal_wrapped(|ui| {
+        ui.checkbox(&mut sentences, "Separar al terminar oracion");
+        ui.checkbox(&mut questions, "Separar preguntas (¿/¡)");
+    });
+    ui.ctx().data_mut(|d| {
+        d.insert_temp(g("chars"), chars);
+        d.insert_temp(g("lines"), lines);
+        d.insert_temp(g("min"), min_s);
+        d.insert_temp(g("max"), max_s);
+        d.insert_temp(g("pause"), pause);
+        d.insert_temp(g("sentences"), sentences);
+        d.insert_temp(g("questions"), questions);
+    });
+    if child.button("Crear pista con estas opciones").clicked() {
+        actions.push(("transcript.createCaptions".into(), estudio_joven_params(ui.ctx())));
+        app.ui.text_tab = "Captions".into();
+    }
+}
