+// SPDX-License-Identifier: AGPL-3.0-or-later
+//! Non-destructive title entrance/exit presets, shared by preview and export.
+use serde::{Deserialize, Serialize};
+use crate::model::{Clip, ClipKey, ClipKind, KeyEase, KeyProperty};
+
+/// Presets: 0 none, 1 fade, 2 slide up, 3 zoom, 4 bounce.
+#[cfg_attr(feature = "schema", derive(schemars::JsonSchema))]
+#[derive(Clone, PartialEq, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub struct TextMotion {
+    pub entrance: u8,
+    pub exit: u8,
+    pub in_seconds: f64,
+    pub out_seconds: f64,
+    pub intensity: f64,
+}
+
+impl Default for TextMotion {
+    fn default() -> Self {
+        Self { entrance: 0, exit: 0, in_seconds: 0.35, out_seconds: 0.25, intensity: 1.0 }
+    }
+}
+
+impl TextMotion {
+    pub fn tidy(mut self) -> Self {
+        fn bounded(n: f64, fallback: f64, min: f64, max: f64) -> f64 {
+            if n.is_finite() { n.clamp(min, max) } else { fallback }
+        }
+        if self.entrance > 4 { self.entrance = 0; }
+        if self.exit > 4 { self.exit = 0; }
+        self.in_seconds = bounded(self.in_seconds, 0.35, 0.05, 3.0);
+        self.out_seconds = bounded(self.out_seconds, 0.25, 0.05, 3.0);
+        self.intensity = bounded(self.intensity, 1.0, 0.1, 2.0);
+        self
+    }
+}
+
+// Progress is 0 when hidden and 1 when settled. Exit plays it backwards.
+fn motion(kind: u8, progress: f64, intensity: f64) -> (f64, f64, f64) {
+    let p = progress.clamp(0.0, 1.0);
+    let eased = 1.0 - (1.0 - p).powi(3);
+    match kind {
+        1 => (1.0, 0.0, eased),
+        2 => (1.0, 0.12 * intensity * (1.0 - eased), eased),
+        3 => ((1.0 - 0.35 * intensity * (1.0 - eased)).max(0.05), 0.0, eased),
+        4 => {
+            let c = 1.70158;
+            let q = p - 1.0;
+            let back = 1.0 + (c + 1.0) * q.powi(3) + c * q.powi(2);
+            ((1.0 + 0.5 * intensity * (back - 1.0)).max(0.05), 0.0, eased)
+        }
+        _ => (1.0, 0.0, 1.0),
+    }
+}
+
+/// Build a transient render copy; saved keyframes remain editable and untouched.
+/// Absolute user curves compose with the preset. Sampling includes their keys
+/// and both animation boundaries. Short clips proportionally shorten the ramps.
+pub fn render_clip(clip: &Clip) -> Clip {
+    let mut out = clip.clone();
+    if clip.kind != ClipKind::Text { return out; }
+    let Some(text) = &clip.text else { return out; };
+    let m = text.motion.clone().tidy();
+    if m.entrance == 0 && m.exit == 0 { return out; }
+    let duration = clip.duration.max(0.001);
+    let mut intro = if m.entrance == 0 { 0.0 } else { m.in_seconds };
+    let mut outro = if m.exit == 0 { 0.0 } else { m.out_seconds };
+    if intro + outro > duration {
+        let factor = duration / (intro + outro);
+        intro *= factor;
+        outro *= factor;
+    }
+    let a = intro / duration;
+    let b = 1.0 - outro / duration;
+    for property in [KeyProperty::Scale, KeyProperty::OffsetY, KeyProperty::Opacity] {
+        let needed = match property {
+            KeyProperty::Scale => m.entrance >= 3 || m.exit >= 3,
+            KeyProperty::OffsetY => m.entrance == 2 || m.exit == 2,
+            _ => true,
+        };
+        if !needed { continue; }
+        let track = clip.track_on(property).resample(64);
+        let mut times = vec![0.0, a, b, 1.0];
+        times.extend(track.keys().iter().map(|key| key.at));
+        for i in 0..=90 {
+            let t = f64::from(i) / 90.0;
+            if intro > 0.0 { times.push(a * t); }
+            if outro > 0.0 { times.push(b + (1.0 - b) * t); }
+        }
+        times.sort_by(f64::total_cmp);
+        times.dedup_by(|x, y| (*x - *y).abs() < 1e-9);
+        out.keys.retain(|key| key.property != property);
+        for at in times {
+            let entering = if intro > 0.0 { motion(m.entrance, at / a, m.intensity) } else { (1.0, 0.0, 1.0) };
+            let leaving = if outro > 0.0 { motion(m.exit, (1.0 - at) / (1.0 - b), m.intensity) } else { (1.0, 0.0, 1.0) };
+            let base = clip.value_at(property, at);
+            let value = match property {
+                KeyProperty::Scale => base * entering.0 * leaving.0,
+                KeyProperty::OffsetY => base + entering.1 + leaving.1,
+                _ => base * entering.2 * leaving.2,
+            };
+            // Do not use set_key: its editing tolerance merges nearby samples.
+            out.keys.push(ClipKey { property, at, value, ease: KeyEase::LINEAR });
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::TextStyle;
+
+    fn title(kind: u8) -> Clip {
+        let mut clip = Clip::blank("t", "track", ClipKind::Text, "Test", 0.0, 2.0);
+        clip.text = Some(TextStyle { motion: TextMotion { entrance: kind, exit: kind, ..Default::default() }, ..Default::default() });
+        clip
+    }
+
+    #[test]
+    fn text_motion_roundtrips_and_old_styles_default_to_none() {
+        let old: TextStyle = serde_json::from_str(r#"{"content":"Hola"}"#).unwrap();
+        assert_eq!(old.motion, TextMotion::default());
+        let clip = title(4);
+        let saved = serde_json::to_string(&clip).unwrap();
+        let loaded: Clip = serde_json::from_str(&saved).unwrap();
+        assert_eq!(loaded.text.unwrap().motion, clip.text.unwrap().motion);
+    }
+
+    #[test]
+    fn text_motion_respects_edges_rest_and_existing_keys() {
+        for kind in 1..=4 {
+            let mut clip = title(kind);
+            clip.scale = 0.8;
+            clip.offset_y = 0.3;
+            clip.opacity = 0.6;
+            clip.set_key(KeyProperty::Rotation, 0.0, 20.0, KeyEase::LINEAR);
+            clip.set_key(KeyProperty::Scale, 0.0, 0.7, KeyEase::LINEAR);
+            clip.set_key(KeyProperty::Scale, 1.0, 1.1, KeyEase::LINEAR);
+            let before = clip.clone();
+            let rendered = render_clip(&clip);
+            assert_eq!(clip, before);
+            assert_eq!(rendered.value_at(KeyProperty::Opacity, 0.0), 0.0);
+            assert_eq!(rendered.value_at(KeyProperty::Opacity, 1.0), 0.0);
+            assert!((rendered.value_at(KeyProperty::Opacity, 0.5) - 0.6).abs() < 1e-6);
+            assert!((rendered.value_at(KeyProperty::Scale, 0.5) - 0.9).abs() < 1e-6);
+            assert!((rendered.value_at(KeyProperty::OffsetY, 0.5) - 0.3).abs() < 1e-6);
+            assert_eq!(rendered.value_at(KeyProperty::Rotation, 0.5), 20.0);
+        }
+    }
+
+    #[test]
+    fn text_motion_short_clips_and_removal_are_safe() {
+        let mut clip = title(4);
+        clip.duration = 0.08;
+        let rendered = render_clip(&clip);
+        assert!(rendered.keys.iter().all(|key| key.value.is_finite() && (0.0..=1.0).contains(&key.at)));
+        clip.text.as_mut().unwrap().motion = TextMotion::default();
+        assert_eq!(render_clip(&clip), clip);
+        assert_eq!(TextMotion { intensity: f64::NAN, in_seconds: f64::INFINITY, ..Default::default() }.tidy().intensity, 1.0);
+    }
+
+    #[test]
+    fn text_motion_bounce_overshoots_and_slide_moves_down_before_settling() {
+        assert!(motion(4, 0.65, 1.0).0 > 1.0);
+        assert!(motion(2, 0.0, 1.0).1 > 0.0);
+        assert_eq!(motion(2, 1.0, 1.0), (1.0, 0.0, 1.0));
+    }
+}
