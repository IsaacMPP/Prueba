+fn caption_look(base: Option<&TextStyle>, mode: usize) -> Option<TextStyle> {
+    if mode != 2 { return base.cloned(); }
+    let mut style = base.cloned().unwrap_or_default();
+    style.font_weight = 800.0;
+    style.color = "#FFE600".into();
+    style.stroke_color = "#111111".into();
+    style.stroke_width = 0.002;
+    style.motion = concat_project::text_motion::TextMotion {
+        entrance: 4, exit: 0, in_seconds: 0.12, out_seconds: 0.05, intensity: 0.8,
+    };
+    Some(style)
+}
