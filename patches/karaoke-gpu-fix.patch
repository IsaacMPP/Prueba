+// SPDX-License-Identifier: AGPL-3.0-or-later
+//! Keep karaoke lexical boundaries independent of Whisper BPE boundaries.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Word { pub text: String, pub start: f64, pub end: f64 }
+
+pub fn split(text: &str, start: f64, end: f64, timed: Vec<Word>) -> Vec<Word> {
+    if !start.is_finite() || !end.is_finite() || end <= start { return vec![]; }
+    let parts: Vec<&str> = text.split_whitespace().collect();
+    if parts.is_empty() { return vec![]; }
+    // Never trust concatenated/missing tokens, special tokens or overlapping
+    // timestamps. Recover the complete transcript with approximate timing.
+    let valid = timed.len() == parts.len() && timed.iter().zip(&parts).all(|(w,p)|
+        w.text.trim() == *p && w.start.is_finite() && w.end.is_finite()
+        && w.start >= start && w.end <= end && w.end > w.start)
+        && timed.windows(2).all(|p| p[0].end <= p[1].start);
+    if valid { return timed; }
+    let total = parts.iter().map(|w| w.chars().count()).sum::<usize>().max(1) as f64;
+    let mut used = 0.0;
+    parts.into_iter().map(|p| {
+        let a = start + (end-start)*used/total;
+        used += p.chars().count() as f64;
+        Word { text: p.into(), start: a, end: start+(end-start)*used/total }
+    }).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn caption_words_never_return_a_paragraph_even_with_bad_tokens() {
+        let text = "Dios nos ama y nos da esperanza";
+        for timed in [vec![], vec![Word { text: text.into(), start: 0.0, end: 1.0 }]] {
+            let words = split(text,0.0,1.0,timed);
+            assert_eq!(words.len(),7);
+            assert!(words.iter().all(|w| w.text.split_whitespace().count()==1));
+            assert!(words.windows(2).all(|w| w[0].end<=w[1].start));
+            assert_eq!(words.last().unwrap().end,1.0);
+        }
+    }
+    #[test]
+    fn caption_words_preserve_valid_timing_and_short_words() {
+        let words=vec![Word{text:"Hola".into(),start:1.0,end:1.08},Word{text:"mundo".into(),start:1.08,end:1.2}];
+        assert_eq!(split("Hola mundo",1.0,1.2,words.clone()),words);
+        assert!(split("hola",f64::NAN,1.0,vec![]).is_empty());
+    }
+}
