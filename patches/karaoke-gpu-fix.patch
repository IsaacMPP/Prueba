+/// Read the backend registry after cpu_backend has loaded bundled modules.
+fn gpu_backend() -> Option<String> {
+    use whisper_rs::whisper_rs_sys as sys;
+    // SAFETY: ggml owns registered devices and their static descriptions.
+    unsafe {
+        let device = sys::ggml_backend_dev_by_type(sys::ggml_backend_dev_type_GGML_BACKEND_DEVICE_TYPE_GPU);
+        if device.is_null() { return None; }
+        let description = sys::ggml_backend_dev_description(device);
+        if description.is_null() { return Some("GPU".into()); }
+        Some(std::ffi::CStr::from_ptr(description).to_string_lossy().into_owned())
+    }
+}
