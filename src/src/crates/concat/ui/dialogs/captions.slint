import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { Switch } from "../inspector/controls.slint";
import { NumberField } from "../primitives/number-field.slint";

// Captions: what the tray's Captions tool opens.
//
// Two sheets in one, and a switch between them: "Use Sample Voice".
// On, the words are a clip's: one picked from the timeline's clips that
// have sound, through the transcriber, cut to the words' own timing. Off,
// they are a script typed here, one title per sentence at reading pace,
// laid down from the playhead. The list holds only clips with sound, so a
// silent video cannot be sent to the transcriber. The switch starts on
// when the sheet is opened on a clip with sound - from the clip's menu, or
// with one selected - and off otherwise. Then where the lines sit and how
// big they are, and one button. While it runs
// the sheet is the progress report: a transcription knows how far through
// the sound it is, so it gets a real bar and not a sweep. The language is
// the transcriber's to work out.
//
// On a desk it is a card floating over the editor (see Modal.floating): the
// timeline stays live under it, so the clip it transcribes follows the
// selection - a clip with sound selected is the one shown and run. Closed,
// a transcription goes on, and opened again the card shows it. On a phone
// it is a sheet.

export struct CaptionsSheetData {
    open: bool,
    /// "Use Sample Voice": the words come from a clip's sound.
    from-voice: bool,
    /// The timeline's clips with sound, by file and start.
    sources: [string],
    /// Row in `sources` of the clip to transcribe; -1 for none.
    source: int,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    // Caption readability controls, not appearance or karaoke state.
    rules-layout: int,
    rules-chars: float,
    rules-words: float,
    rules-min-seconds: float,
    rules-max-seconds: float,
    rules-gap-frames: float,
    running: bool,
    /// 0..1: where the transcription surely is.
    progress: float,
    /// Where the step under way leaves the bar, 0..1.
    ceiling: float,
    /// Seconds that step should take.
    step: float,
    /// Seconds of the run still to go, once the work has been timed;
    /// negative before.
    left: float,
    /// What the run is doing, in words.
    stage: string,
    // Estudio Joven native phrase editing; all changes originate in Rust.
    editor-tab: int,
    editor-kind: int,
    editor-items: [string],
    editor-selected: int,
    editor-text: string,
    editor-dirty: bool,
    editor-confirm: bool,
    editor-message: string,
    /// Persistent mode and word timing of the selected native subtitle.
    karaoke-enabled: bool,
    karaoke-mode: int,
    karaoke-color: int,
    karaoke-words: [string],
    karaoke-word-index: int,
    karaoke-has-times: bool,
    karaoke-word-start: float,
    karaoke-word-end: float,
    karaoke-alignment: string,
    /// A transcriber model is installed.
    ready: bool,
    /// Why the last run failed, when it did.
    message: string,
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback rules-layout(index: int);
    callback rules-chars(value: float);
    callback rules-words(value: float);
    callback rules-min-seconds(value: float);
    callback rules-max-seconds(value: float);
    callback rules-gap-frames(value: float);
    callback begin();
    callback cancel();
    callback import-srt();
    callback export-srt();
    callback editor-tab-changed(index: int);
    callback editor-kind-changed(index: int);
    callback editor-selected(index: int);
    callback editor-text-edited(text: string);
    callback editor-apply();
    callback editor-discard();
    callback editor-stay();
    callback karaoke-mode(index: int);
    callback karaoke-color(index: int);
    callback karaoke-estimate();
    callback karaoke-word-selected(index: int);
    callback karaoke-word-start(value: float);
    callback karaoke-word-end(value: float);

    property <bool> from-voice: root.data.from-voice;

    open: root.data.open;
    title: I18n.t("captions.captions");
    glyph: Glyph.text-mark;
    surface-width: 540px;
    dismissable: !root.data.running;

    // The script being typed, held apart from `data.text` the way the Field
    // primitive holds its draft: a TextInput's binding is dropped on the
    // first keystroke, so the sheet re-seeds it when it opens and never
    // while it is being typed into.
    property <string> draft;
    property <string> edit-draft;
    property <bool> edit-typing;
    /// The script has the caret. Kept up here because the box lives under
    /// an `if`, and nothing outside one can reach into it.
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
        if (!root.edit-typing) {
            root.edit-draft = root.data.editor-text;
        }
    }
    init => {
        root.draft = root.data.text;
        root.edit-draft = root.data.editor-text;
    }

    VerticalLayout {
        if !root.data.running: DialogSection {
            first: true;
            title: "Estudio Joven";
            SegmentedControl {
                options: ["Generar", "Editar"];
                current: root.data.editor-tab;
                changed(index) => {
                    root.edit-typing = false;
                    root.editor-tab-changed(index);
                }
            }
        }

        if !root.data.running && root.data.editor-tab == 1: DialogSection {
            title: "Transcripción y subtítulos";

            DialogRow {
                label: "Contenido";
                SegmentedControl {
                    options: ["Transcripción", "Subtítulos"];
                    current: root.data.editor-kind;
                    changed(index) => {
                        root.edit-typing = false;
                        root.editor-kind-changed(index);
                    }
                }
            }

            DialogRow {
                label: "Frase";
                Select {
                    options: root.data.editor-items;
                    current: root.data.editor-selected;
                    placeholder: "No hay frases disponibles";
                    enabled: root.data.editor-items.length > 0 && !root.data.editor-confirm;
                    changed(index) => {
                        root.edit-typing = false;
                        root.editor-selected(index);
                    }
                }
            }

            Rectangle {
                height: 110px;
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: edit-field.has-focus ? Theme.accent : Theme.line;
                clip: true;
                edit-field := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.edit-draft;
                    enabled: root.data.editor-selected >= 0 && !root.data.editor-confirm;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.edit-typing = self.has-focus; }
                    edited => { root.editor-text-edited(self.text); }
                }
            }

            if root.data.editor-message != "": Text {
                text: root.data.editor-message;
                color: Theme.danger;
                wrap: word-wrap;
                font-size: Theme.fs-sm;
            }

            if root.data.editor-confirm: VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Tienes cambios sin aplicar. ¿Qué deseas hacer?";
                    color: Theme.fg;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        label: "Aplicar";
                        primary: true;
                        clicked => { root.edit-typing = false; root.editor-apply(); }
                    }
                    Button {
                        label: "Descartar";
                        clicked => { root.edit-typing = false; root.editor-discard(); }
                    }
                    Button {
                        label: "Seguir editando";
                        ghost: true;
                        clicked => { root.editor-stay(); }
                    }
                }
            }

            if !root.data.editor-confirm: HorizontalLayout {
                spacing: 8px;
                Button {
                    label: "Aplicar cambios";
                    primary: true;
                    enabled: root.data.editor-selected >= 0 && root.data.editor-dirty;
                    clicked => { root.edit-typing = false; root.editor-apply(); }
                }
                Button {
                    label: "Descartar cambios";
                    enabled: root.data.editor-selected >= 0 && root.data.editor-dirty;
                    clicked => { root.edit-typing = false; root.editor-discard(); }
                }
            }

            Text {
                text: root.data.editor-kind == 0
                    ? "Corrige una transcripción guardada. Si el subtítulo aún tiene el texto original, se actualizará junto con la frase."
                    : "Cada subtítulo mantiene su estilo individual. La tipografía y los efectos se cambian en el inspector Texto original.";
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            if root.data.editor-kind == 1 && root.data.karaoke-enabled: VerticalLayout {
                spacing: 8px;
                Text {
                    text: I18n.t("captions.karaokeEditingTitle");
                    font-weight: 600;
                    color: Theme.fg;
                }
                DialogRow {
                    label: I18n.t("captions.karaokeModeLabel");
                    SegmentedControl {
                        options: [I18n.t("captions.karaokeNormal"), I18n.t("captions.karaokeProgressive"), I18n.t("captions.karaokeWordMode")];
                        current: root.data.karaoke-mode;
                        enabled: !root.data.editor-dirty && !root.data.editor-confirm;
                        changed(index) => { root.karaoke-mode(index); }
                    }
                }
                DialogRow {
                    label: I18n.t("captions.karaokeColorLabel");
                    Select {
                        options: [I18n.t("captions.karaokeYellow"), I18n.t("captions.karaokeCyan"), I18n.t("captions.karaokePink"), I18n.t("captions.karaokeGreen")];
                        current: root.data.karaoke-color;
                        enabled: !root.data.editor-dirty && !root.data.editor-confirm;
                        changed(index) => { root.karaoke-color(index); }
                    }
                }
                Text {
                    text: root.data.karaoke-alignment;
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Button {
                    label: I18n.t("captions.karaokeEstimateAction");
                    enabled: !root.data.editor-dirty && !root.data.editor-confirm;
                    clicked => { root.karaoke-estimate(); }
                }
                if root.data.karaoke-words.length > 0: DialogRow {
                    label: I18n.t("captions.karaokeWordLabel");
                    Select {
                        options: root.data.karaoke-words;
                        current: root.data.karaoke-word-index;
                        enabled: !root.data.editor-dirty && !root.data.editor-confirm;
                        changed(index) => { root.karaoke-word-selected(index); }
                    }
                }
                if root.data.karaoke-has-times && root.data.karaoke-word-index >= 0: DialogRow {
                    label: I18n.t("captions.karaokeStart");
                    NumberField {
                        value: root.data.karaoke-word-start;
                        minimum: 0;
                        precision: 3;
                        step: 0.01;
                        unit: "s";
                        enabled: !root.data.editor-dirty && !root.data.editor-confirm;
                        changed(value) => { root.karaoke-word-start(value); }
                    }
                }
                if root.data.karaoke-has-times && root.data.karaoke-word-index >= 0: DialogRow {
                    label: I18n.t("captions.karaokeEnd");
                    NumberField {
                        value: root.data.karaoke-word-end;
                        minimum: 0;
                        precision: 3;
                        step: 0.01;
                        unit: "s";
                        enabled: !root.data.editor-dirty && !root.data.editor-confirm;
                        changed(value) => { root.karaoke-word-end(value); }
                    }
                }
                Text {
                    text: I18n.t("captions.karaokeRenderInfo");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
        }

        if !root.data.running && root.data.editor-tab == 0 && !root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.script");

            Rectangle {
                height: 104px;
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: script.has-focus ? Theme.accent : Theme.line;
                clip: true;

                script := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.draft;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.typing = self.has-focus; }
                    edited => { root.text-edited(self.text); }
                    // Home and End are unbound in Slint on macOS and would
                    // walk up to the window's playhead shortcuts.
                    key-pressed(event) => {
                        if (event.text == Key.Home) {
                            self.set-selection-offsets(0, 0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.set-selection-offsets(1000000000, 1000000000);
                            return accept;
                        }
                        return reject;
                    }
                }

                if root.draft == "" && !script.has-focus: Text {
                    x: 10px;
                    y: 8px;
                    text: I18n.t("captions.typeWordsPutScreen");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-lg;
                }
            }
        }

        // The switch, under the script it stands in for: off, the words
        // are typed above it; on, they come from a clip's voice, chosen
        // under it. A row of its own rather than a DialogRow, whose label
        // column is too narrow for the words.
        if !root.data.running && root.data.editor-tab == 0: HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            spacing: 10px;

            Text {
                horizontal-stretch: 1;
                text: I18n.t("captions.transcribeClipVoice");
                color: Theme.fg;
                font-size: Theme.fs;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.from-voice;
                    toggled(on) => { root.voice-toggled(on); }
                }
            }
        }

        if !root.data.running && root.data.editor-tab == 0 && root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.transcriber");

            DialogRow {
                label: I18n.t("common.audio");
                Select {
                    options: root.data.sources;
                    current: root.data.source;
                    placeholder: I18n.t("captions.noVoiceOnTimeline");
                    enabled: root.data.sources.length > 0;
                    changed(index) => { root.source-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.model");
                Select {
                    options: root.models;
                    current: root.data.model;
                    placeholder: I18n.t("common.noneInstalled");
                    enabled: root.models.length > 0;
                    changed(index) => { root.model-changed(index); }
                }
            }

            if !root.data.ready: Text {
                text: I18n.t("captions.downloadTranscriberModelFirst");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running && root.data.editor-tab == 0: DialogSection {
            title: I18n.t("captions.captions");

            DialogRow {
                label: I18n.t("captions.placement");
                SegmentedControl {
                    options: [I18n.t("common.bottom"), I18n.t("captions.centre"), I18n.t("common.top")];
                    current: root.data.placement;
                    changed(index) => { root.placement-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.size");
                SegmentedControl {
                    options: [I18n.t("common.small"), I18n.t("common.medium"), I18n.t("common.large")];
                    current: root.data.size;
                    changed(index) => { root.size-changed(index); }
                }
            }

            if !root.from-voice: Text {
                text: I18n.t("captions.oneTitlePerSentence");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running && root.data.editor-tab == 0 && root.from-voice: DialogSection {
            title: I18n.t("captions.segmentationTitle");
            collapsible: true;

            DialogRow {
                label: I18n.t("captions.segmentationLayout");
                SegmentedControl {
                    options: [I18n.t("captions.oneLine"), I18n.t("captions.twoLines"), I18n.t("captions.oneWord")];
                    current: root.data.rules-layout;
                    changed(index) => { root.rules-layout(index); }
                }
            }
            DialogRow {
                label: I18n.t("captions.charactersPerLine");
                NumberField {
                    value: root.data.rules-chars;
                    minimum: 12;
                    maximum: 80;
                    precision: 0;
                    unit: I18n.t("captions.charactersUnit");
                    changed(value) => { root.rules-chars(value); }
                }
            }
            DialogRow {
                label: I18n.t("captions.maxWords");
                NumberField {
                    value: root.data.rules-words;
                    minimum: 1;
                    maximum: 40;
                    precision: 0;
                    unit: I18n.t("captions.wordsUnit");
                    enabled: root.data.rules-layout != 2;
                    changed(value) => { root.rules-words(value); }
                }
            }
            DialogRow {
                label: I18n.t("captions.minDuration");
                NumberField {
                    value: root.data.rules-min-seconds;
                    minimum: 0.1;
                    maximum: root.data.rules-max-seconds;
                    step: 0.1;
                    precision: 1;
                    unit: "s";
                    changed(value) => { root.rules-min-seconds(value); }
                }
            }
            DialogRow {
                label: I18n.t("captions.maxDuration");
                NumberField {
                    value: root.data.rules-max-seconds;
                    minimum: root.data.rules-min-seconds;
                    maximum: 20;
                    step: 0.5;
                    precision: 1;
                    unit: "s";
                    changed(value) => { root.rules-max-seconds(value); }
                }
            }
            DialogRow {
                label: I18n.t("captions.gapFrames");
                NumberField {
                    value: root.data.rules-gap-frames;
                    minimum: 0;
                    maximum: 12;
                    precision: 0;
                    unit: I18n.t("captions.framesUnit");
                    changed(value) => { root.rules-gap-frames(value); }
                }
            }
            Text {
                text: I18n.t("captions.estimatedTimingHint");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: VerticalLayout {
                spacing: 8px;

                row := HorizontalLayout {
                    spacing: 8px;
                    // The time left, once the work has been timed: counted down
                    // from the last report, and gone in the last second.
                    property <int> left: Math.ceil(Math.max(0, root.data.left - bar.since / 1s));

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.stage;
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    if root.data.left >= 0 && row.left > 0: Text {
                        text: I18n.t2("common.aboutLeft", "\{Math.floor(row.left / 60)}",
                            (Math.mod(row.left, 60) < 10 ? "0" : "") + "\{Math.mod(row.left, 60)}");
                        color: Theme.fg-dim;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "\{Math.floor(bar.shown * 100)}%";
                        color: Theme.fg-muted;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }

                bar := Progress {
                    value: root.data.progress;
                    ceiling: root.data.ceiling;
                    step: root.data.step * 1s;
                    live: true;
                }
            }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running && root.data.editor-tab == 0: Button {
                block: true;
                primary: true;
                large: true;
                glyph: Glyph.text-mark;
                label: root.from-voice ? I18n.t("captions.generateCaptions") : I18n.t("captions.addCaptions");
                enabled: root.from-voice ? root.data.ready && root.data.source >= 0 : root.draft != "";
                clicked => { root.begin(); }
            }

            // Captions as a SubRip file: one read in as titles with the
            // look above, timed as the file says; or a lane of titles
            // written out: the selected title's lane, or with none
            // selected the lane with the most titles, the captions'.
            if !root.data.running && root.data.editor-tab == 0: HorizontalLayout {
                spacing: 8px;

                Button {
                    horizontal-stretch: 1;
                    block: true;
                    ghost: true;
                    glyph: Glyph.import;
                    label: I18n.t("captions.importSrt");
                    clicked => { root.import-srt(); }
                }

                Button {
                    horizontal-stretch: 1;
                    block: true;
                    ghost: true;
                    glyph: Glyph.export;
                    label: I18n.t("captions.exportSrt");
                    clicked => { root.export-srt(); }
                }
            }
        }
    }
}
